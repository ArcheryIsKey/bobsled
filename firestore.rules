rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function ownsWallet(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['walletAddress', 'username', 'elo', 'freeTokens', 'createdAt'])
        && (data.walletAddress == null || (data.walletAddress is string && data.walletAddress.size() <= 100))
        && data.username is string && data.username.size() <= 50
        && (!("avatarUrl" in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 300000))
        && (!("testSolBalance" in data) || data.testSolBalance is number)
        && (!("isTestUser" in data) || data.isTestUser is bool)
        && data.elo is number
        && data.freeTokens is number;
    }
    
    function isValidUserUpdate(data) {
      return (data.walletAddress == null || (data.walletAddress is string && data.walletAddress.size() <= 100))
        && data.username is string && data.username.size() <= 50
        && (!("avatarUrl" in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 300000))
        && (!("testSolBalance" in data) || data.testSolBalance is number)
        && (!("isTestUser" in data) || data.isTestUser is bool)
        && data.elo is number
        && data.freeTokens is number;
    }

    function isValidGame(data) {
      return data.keys().hasAll(['player1', 'player1Name', 'status', 'board', 'wager', 'wagerCurrency', 'createdAt', 'updatedAt'])
        && data.player1 is string && data.player1.size() <= 100
        && data.player1Name is string && data.player1Name.size() <= 50
        && data.status in ['waiting', 'active', 'finished']
        && data.board is list && data.board.size() == 42 && data.board[0] is number
        && data.wager is number
        && data.wagerCurrency in ['SOL', 'FREE']
        && (!("isTestGame" in data) || data.isTestGame is bool)
        && (!("player1IsTest" in data) || data.player1IsTest is bool)
        && (!("player2Name" in data) || (data.player2Name == null || (data.player2Name is string && data.player2Name.size() <= 50)))
        && (!("player2" in data) || (data.player2 == null || (data.player2 is string && data.player2.size() <= 100)))
        && (!("player2IsTest" in data) || (data.player2IsTest == null || data.player2IsTest is bool))
        && (!("players" in data) || data.players is list)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidGameUpdate(data) {
      return data.player1 is string && data.player1.size() <= 100
        && data.status in ['waiting', 'active', 'finished']
        && data.board is list && data.board.size() == 42 && data.board[0] is number
        && data.wager is number
        && data.wagerCurrency in ['SOL', 'FREE']
        && (!("isTestGame" in data) || data.isTestGame is bool)
        && data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt']) && data.keys().size() == 3
        && data.senderId is string && data.senderId.size() <= 100
        && data.text is string && data.text.size() <= 500
        && data.createdAt == request.time;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.walletAddress == '11111111111111111111111111111111';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUserUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'walletAddress', 'isTestUser', 'testSolBalance']);
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow delete: if isAdmin();
      
      allow create: if ownsWallet(incoming().player1)
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().status == 'waiting';

      allow update: if isSignedIn()
        && isValidId(gameId)
        && isValidGameUpdate(incoming())
        && existing().status != 'finished'
        && (
          // Action: Join game
          (
            existing().status == 'waiting'
            && incoming().status == 'active'
            && ownsWallet(incoming().player2)
            && incoming().turn in [existing().player1, incoming().player2] // Random turn assigned
            && incoming().diff(existing()).affectedKeys().hasAny(['player2', 'player2Name', 'player2IsTest', 'status', 'turn', 'updatedAt', 'players'])
            && incoming().diff(existing()).affectedKeys().hasOnly(['player2', 'player2Name', 'player2IsTest', 'status', 'turn', 'updatedAt', 'players', 'wager', 'wagerCurrency', 'isTestGame'])
          ) ||
          // Action: Make move
          (
            existing().status == 'active'
            && incoming().status in ['active', 'finished']
            && (ownsWallet(existing().player1) || ownsWallet(existing().player2))
            && ownsWallet(existing().turn) // It must be their turn
            && (incoming().diff(existing()).affectedKeys().hasOnly(['board', 'turn', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['board', 'turn', 'updatedAt', 'status', 'winner']))
          )
        );
    }

    match /games/{gameId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow delete: if isAdmin();
      allow create: if ownsWallet(incoming().senderId)
        && isValidId(gameId)
        && isValidId(messageId)
        // Ensure the sender is a player in the game
        && exists(/databases/$(database)/documents/games/$(gameId))
        && (
          get(/databases/$(database)/documents/games/$(gameId)).data.player1 == incoming().senderId ||
          get(/databases/$(database)/documents/games/$(gameId)).data.player2 == incoming().senderId
        );
      allow update: if false; // Messages are immutable
    }
  }
}

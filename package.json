    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",

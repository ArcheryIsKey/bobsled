rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function ownsWallet(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    
    function isValidUser(data) {
      return data.keys().hasAll(['walletAddress', 'username', 'createdAt'])
        && (data.walletAddress == null || (data.walletAddress is string && data.walletAddress.size() <= 100))
        && data.username is string && data.username.size() <= 50
        && (!("avatarUrl" in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000000))
        && (!("bannerUrl" in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 1000000));
    }
    
    function isValidUserUpdate(data) {
      return (data.walletAddress == null || (data.walletAddress is string && data.walletAddress.size() <= 100))
        && data.username is string && data.username.size() <= 50
        && (!("avatarUrl" in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 1000000))
        && (!("bannerUrl" in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 1000000));
    }

    function isValidGame(data) {
      return data.keys().hasAll(['player1', 'player1Name', 'status', 'board', 'wager', 'wagerCurrency', 'createdAt', 'updatedAt'])
        && data.player1 is string && data.player1.size() <= 100
        && data.player1Name is string && data.player1Name.size() <= 50
        && data.status in ['waiting', 'active', 'finished']
        && data.board is list && data.board.size() == 42
        && data.wager is number
        && data.wager <= 100
        && data.wagerCurrency in ['SOL', 'FREE']
        && (
             (data.wagerCurrency == 'FREE' && data.wager == 0) ||
             (data.wagerCurrency == 'SOL' && data.wager >= 0.001)
           )
        && (!("player1Avatar" in data) || data.player1Avatar == null || data.player1Avatar is string)
        && (!("player2Avatar" in data) || data.player2Avatar == null || data.player2Avatar is string)
        && (!("player2Name" in data) || (data.player2Name == null || (data.player2Name is string && data.player2Name.size() <= 50)))
        && (!("player2" in data) || (data.player2 == null || (data.player2 is string && data.player2.size() <= 100)))
        && (!("players" in data) || data.players is list)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidGameUpdate(data) {
      return data.player1 is string && data.player1.size() <= 100
        && data.status in ['waiting', 'active', 'finished']
        && data.board is list && data.board.size() == 42
        && data.wager is number
        && data.wagerCurrency in ['SOL', 'FREE']
        && data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'createdAt'])
        && data.senderId is string && data.senderId.size() <= 100
        && data.text is string && data.text.size() <= 500;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
         && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isAdmin() {
      return isOwner() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      // Owner cannot be deleted by anyone
      allow delete: if isOwner() && existing().role != 'owner';
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId 
          && isValidId(userId)
          && isValidUserUpdate(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['avatarUrl', 'bannerUrl', 'walletAddress', 'username']))
        || (isOwner() && incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role']));
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow list: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
    }

    match /games/{gameId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && existing().player1 == request.auth.uid && existing().status == 'waiting');
      
      allow create: if ownsWallet(incoming().player1)
        && isValidId(gameId)
        && isValidGame(incoming())
        && incoming().status == 'waiting';

      allow update: if isSignedIn()
        && isValidId(gameId)
        && isValidGameUpdate(incoming())
        && incoming().wager == existing().wager
        && incoming().wagerCurrency == existing().wagerCurrency
        && existing().status != 'finished'
        && (
          // Action: Join game
          (
            existing().status == 'waiting'
            && incoming().status in ['waiting', 'active']
            && incoming().board == existing().board
            && (
              ownsWallet(incoming().player2) ||
              ownsWallet(incoming().player1)
            )
            && (!('turn' in incoming()) || incoming().turn in [existing().player1, request.auth.uid])
          ) ||
          // Action: Deposit & Escrow tracking
          (
            (ownsWallet(existing().player1) || ownsWallet(incoming().player1) || ownsWallet(existing().player2) || ownsWallet(incoming().player2))
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['p1DepositTx', 'escrowStatus', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['p2DepositTx', 'escrowStatus', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['p1DepositTx', 'p1Wallet', 'escrowStatus', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['p2DepositTx', 'p2Wallet', 'escrowStatus', 'updatedAt'])
            )
          ) ||
          // Action: Make move, finish, resign, or heartbeat
          (
            existing().status == 'active'
            && (ownsWallet(existing().player1) || ownsWallet(existing().player2))
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['board', 'turn', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['board', 'turn', 'updatedAt', 'status', 'winner']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winner', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['player1Heartbeat', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['player2Heartbeat', 'updatedAt'])
            )
          )
        );
    }

    match /games/{gameId}/messages/{messageId} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/games/$(gameId))
        && (
          get(/databases/$(database)/documents/games/$(gameId)).data.player1 == request.auth.uid
          || get(/databases/$(database)/documents/games/$(gameId)).data.player2 == request.auth.uid
          || isAdmin()
        );
      allow list: if isSignedIn() && exists(/databases/$(database)/documents/games/$(gameId))
        && (
          get(/databases/$(database)/documents/games/$(gameId)).data.player1 == request.auth.uid
          || get(/databases/$(database)/documents/games/$(gameId)).data.player2 == request.auth.uid
          || isAdmin()
        );
      allow delete: if isAdmin();
      allow create: if ownsWallet(incoming().senderId)
        && isValidId(gameId)
        && isValidId(messageId)
        && isValidMessage(incoming())
        && exists(/databases/$(database)/documents/games/$(gameId))
        && (
          get(/databases/$(database)/documents/games/$(gameId)).data.player1 == request.auth.uid
          || get(/databases/$(database)/documents/games/$(gameId)).data.player2 == request.auth.uid
        );
      allow update: if false;
    }
  }
}
